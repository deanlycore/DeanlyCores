# Copy to .env.local. Do not commit real keys.
# Deanly uses the legacy anon JWT for @supabase/ssr when both keys are set.
# The publishable key is a fallback if the anon key is omitted.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used for password-reset redirects. Defaults to the incoming request origin.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
